# Database - Local Docker
DATABASE_URL="postgresql://projecthub:projecthub@localhost:5432/projecthub?schema=public"
# `directUrl` target for `prisma migrate`. With local Postgres there is no
# pooler, so point it at the same URL.
DATABASE_URL_UNPOOLED="postgresql://projecthub:projecthub@localhost:5432/projecthub?schema=public"

# Auth (Better Auth)
BETTER_AUTH_SECRET="dev-secret-change-me-in-production-32-chars-min"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="http://localhost:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="dev-anon-key"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
