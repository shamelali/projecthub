# Database
# Pooled endpoint (hostname contains "-pooler") — used for runtime query traffic.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.us-east-1.neon.tech/projecthub?sslmode=require"
# Direct endpoint (no "-pooler") — required by `prisma migrate` as `directUrl`.
# Schema migrations must bypass PgBouncer transaction pooling.
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.us-east-1.neon.tech/projecthub?sslmode=require"

# Auth (Better Auth)
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
# Comma-separated list of allowed redirect origins.
BETTER_AUTH_TRUSTED_ORIGINS=""
GITHUB_ID=""
GITHUB_SECRET=""
GITLAB_ID=""
GITLAB_SECRET=""
# Demo mode: set to "true" to allow the demo@projecthub.dev account to sign in.
# Leave unset in production so the demo account cannot exist or authenticate.
DEMO_MODE=""
DEMO_PASSWORD=""

# Email (for verification & password reset). Required in production.
# Development uses a built-in SMTP logger (no external service needed).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@example.com"

# Sentry (error tracking). Set SENTRY_DSN in production.
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# Local filesystem project scanner (fs + git binary).
# Has no effect on serverless hosts — leave unset in production.
ENABLE_LOCAL_SCAN=""

# Supabase (for Realtime)
NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Vercel (for deployment API)
VERCEL_TOKEN=""

# Optional
NEXT_PUBLIC_APP_URL="http://localhost:3000"
