# Environment variables for ProjectHub.
#
# Every variable listed here is read by the code. Framework-provided values
# (NODE_ENV, NEXT_RUNTIME, VERCEL_ENV, CI) are managed by the platform and are
# deliberately omitted.
#
# Copy to .env.local for development:  cp .env.example .env.local
# Fill in the blanks, then:              pnpm db:migrate && pnpm dev

# ─── Database (Neon Postgres / any Postgres) ──────────────────────────────────
# Pooled endpoint (hostname contains "-pooler") — used for runtime query traffic.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.us-east-1.neon.tech/neondb?sslmode=require"
# Direct endpoint (no "-pooler") — read by Prisma as `directUrl`, so schema
# migrations bypass PgBouncer transaction pooling.
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.us-east-1.neon.tech/neondb?sslmode=require"

# ─── Auth (Better Auth) ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public origin of this deployment. Must be the real host — a wrong value breaks
# OAuth callbacks and verification links. Never use projecthub.vercel.app if it is
# not your deployment; that host belongs to another project.
BETTER_AUTH_URL="http://localhost:3000"
# Comma-separated origins allowed to receive auth callbacks. Empty in dev.
BETTER_AUTH_TRUSTED_ORIGINS=""

# OAuth providers. Each pair is enabled only when BOTH values are non-empty, so
# leaving them blank simply hides that provider on the sign-in screen.
# Full registration walkthrough (callback URLs, scopes, verification):
#   docs/operations.md → "OAuth provider setup"
# GitHub: https://github.com/settings/developers → OAuth App
#   Authorization callback URL: ${BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_ID=""
GITHUB_SECRET=""
# GitLab: https://gitlab.com/-/profile/applications
#   Redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/gitlab
GITLAB_ID=""
GITLAB_SECRET=""

# ─── Demo account ─────────────────────────────────────────────────────────────
# Set DEMO_MODE="true" to create and allow the demo account. Leave it unset (or
# "false") in production: the session gate refuses the demo user regardless of
# what is in the database, so a previously seeded account cannot sign in.
DEMO_MODE=""
# Only needed when DEMO_MODE="true". scripts/seed.ts and set-demo-password.ts
# both require it, and it must be at least 16 characters.
DEMO_PASSWORD=""
# Optional override of the demo account's address. The auth gate reads this too,
# so changing it keeps the two in sync. Defaults to demo@projecthub.dev.
DEMO_EMAIL=""

# ─── Email (verification & password reset) via the Brevo HTTP API ─────────────
# Required in production; development logs to stdout and needs none of these.
# Key:   https://app.brevo.com/settings/keys/api
# Senders that are authenticated in Brevo: https://app.brevo.com/senders
BREVO_API_KEY=""
EMAIL_FROM="admin@dutaintegra.my"
EMAIL_FROM_NAME="ProjectHub"

# ─── Sentry (error monitoring) ────────────────────────────────────────────────
# Server-side DSN (kept secret). Also gates `silent` in next.config.js.
SENTRY_DSN=""
# Browser DSN. NEXT_PUBLIC_* because it is inlined into the client bundle.
NEXT_PUBLIC_SENTRY_DSN=""
# Org and project slugs, used at build time to name uploaded source maps.
# Find them at https://<org>.sentry.io/settings/projects/<project> → Client Keys
SENTRY_ORG=""
SENTRY_PROJECT=""
# Build-time only. Without it source maps are not uploaded, so stack traces stay
# minified. Create a Fine-grained token at
# https://<org>.sentry.io/settings/account/api/auth-tokens/
# with scopes: org:read, project:releases, project:write.
# Region is inferred from the DSN host, so no separate setting is needed.
SENTRY_AUTH_TOKEN=""
# ─── Daily git-sync cron ──────────────────────────────────────────────────────
# vercel.json schedules GET /api/cron/sync-git at 04:00 UTC. Vercel Cron sends
# this value as `Authorization: Bearer` automatically. Generate with:
#   openssl rand -hex 24
CRON_SECRET=""
