// Cloudflare Workers deployment for the Next.js app via @opennextjs/cloudflare.
// https://opennext.js.org/cloudflare/get-started
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "projecthub",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    // Enable Node.js API polyfills (required by Next.js / OpenNext).
    "nodejs_compat",
    // Allow fetching public URLs from the worker (Brevo, Sentry, Neon, ...).
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // Move the worker next to the (us-east-2) Neon database — cuts the per-request
  // TCP+TLS handshake latency that dominated cold-page times.
  "placement": { "mode": "smart" },
  // Hyperdrive pools Postgres connections at the edge; lib/db.ts reads
  // env.HYPERDRIVE.connectionString on Workers. Pooler URL — Hyperdrive and
  // PgBouncer both pool, and Neon's docs recommend the pooled endpoint here.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "5054885dfad740c0aff3ae42b6d1e91f",
    },
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      // Must match the worker "name" above.
      "service": "projecthub",
    },
  ],
  // Non-secret runtime env vars. Secrets (DATABASE_URL, BETTER_AUTH_SECRET,
  // BREVO_API_KEY, ...) are set with `wrangler secret put` instead.
  "vars": {
    // NOTE: must match the workers.dev subdomain of the account wrangler
    // deploys to — currently Shamelali@gmail.com's Account (subdomain
    // `shamelali`). Update if you switch accounts.
    "BETTER_AUTH_URL": "https://projecthub.shamelali.workers.dev",
    "BETTER_AUTH_TRUSTED_ORIGINS": "https://projecthub.shamelali.workers.dev,https://projecthub-ashy-sigma.vercel.app",
    "EMAIL_FROM": "admin@dutaintegra.my",
    "EMAIL_FROM_NAME": "ProjectHub",
  },
  "observability": {
    "enabled": true,
  },
}
